# Dependencies
node_modules/

# Build & Test outputs
dist/
coverage/

# Persistence & state snapshots
data/db.json
data/db.json.tmp
data/*.corrupt.*

# Log files (regenerated at runtime by src/utils/logManager.js)
logs/*.log

# Uploaded files (regenerated at runtime by src/middleware/fileUpload.js)
uploads/documents/*
uploads/branding/*
uploads/inventory/*
!uploads/documents/.gitkeep
!uploads/branding/.gitkeep
!uploads/inventory/.gitkeep

# Local environment variables & secrets
.env
.env.local
.env.*.local
